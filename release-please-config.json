  "draft": false,
  "prerelease": false,
  "packages": {
    "go": {
      "release-type": "go",
      "component": "go",
      "tag-separator": "/"
    },
    "javascript/server": {
      "release-type": "node",
      "component": "javascript-server"
    },
    "javascript/web": {
      "release-type": "node",
      "component": "javascript-web"
    },
    "python": {
      "release-type": "python",
      "component": "python"
    }
  }
}
